{
  "enabledPlugins": {
    "caveman@caveman": true
  },
  "permissions": {
    "allow": ["Bash(npm run *)"],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./.turbo/**)",
      "Read(./.cache/**)",
      "Read(**/*.log)",
      "Read(**/package-lock.json)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/yarn.lock)"
    ]
  }
}
